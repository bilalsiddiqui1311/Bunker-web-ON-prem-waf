# Copy this file to .env before `docker compose up`.
# .env should NOT be committed to git.

# Space-separated list of every domain this BunkerWeb will front.
# Example for EC2: www.alphansn.com bunkerweb.we-are-asap.com
SERVER_NAMES=www.alphansn.com bunkerweb.we-are-asap.com

# Shared key used by the BunkerWeb bouncer and CrowdSec Local API.
# Generate with: openssl rand -base64 32
CROWDSEC_API_KEY=replace-with-strong-random-api-key

# Shared BunkerWeb/UI database credentials.
# Generate with: openssl rand -base64 32
DB_PASSWORD=replace-with-strong-random-db-password

# Web UI administrator. The password must include upper/lowercase, a digit,
# and a special character.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Let's Encrypt email for certificate renewal notifications
EMAIL_LETS_ENCRYPT=your-email@example.com

# Set to "yes" for staging certificates (recommended for testing).
# Change to "no" after certificates are working in production.
USE_LETS_ENCRYPT_STAGING=yes
